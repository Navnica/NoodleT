/lib/l10n/app_localizations*.dart

# Not ignored on purpose: the icons flutter_launcher_icons generates into
# windows/ and macos/. A build needs them and does not run the generator.

# Debug symbols and obfuscation maps of release builds
app.*.symbols
app.*.map.json

